# Secrets — never commit real credentials or generated key material.
.env
# Local Compose override holding real MongoDB Atlas credentials.
docker-compose.local.yaml

# Generated TLS certificates and keys (run security/gen-certs.sh locally).
security/*.crt
security/*.key
security/*.srl

# Generated Mosquitto password file (run security/gen-passwd.sh locally).
mqtt/passwd

# Node
**/node_modules

# Runtime data / state
mongo-data*
mqtt/data
node-red/.config*
node-red/.sessions*
node-red/flows_cred.json

# OS / editor
.DS_Store
**/.DS_Store
out/
**.drawio
**.svg
**.pdf
**.docx
__pycache__/