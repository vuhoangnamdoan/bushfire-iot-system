# .env.example — environment variables for the Bushfire stack.
#
# Copy to .env and edit. docker-compose reads .env automatically. NEVER commit
# your real .env (it is gitignored) — this file documents the variables only,
# with safe placeholder values.
#
#   cp .env.example .env
#
# Defaults keep the stack OPEN (no auth, no TLS) so scaling/throughput tests run
# unchanged. Turn the two flags on to run with the full security layer.

# ---------------------------------------------------------------------------
# Feature flags — the on/off switches for the security layer.
# ---------------------------------------------------------------------------
# AUTH_ENABLED  gates REST API bearer-token auth on the write endpoints.
# TLS_ENABLED   makes MQTT clients connect over mqtts:// and verify the broker.
AUTH_ENABLED=false
TLS_ENABLED=false

# ---------------------------------------------------------------------------
# REST API token auth (microservices).
# ---------------------------------------------------------------------------
# Shared secret checked as "Authorization: Bearer <token>" on POST endpoints.
# Generate a strong one for real use, e.g.:  openssl rand -hex 32
API_TOKEN=dev-change-me-0000000000000000

# ---------------------------------------------------------------------------
# MQTT broker authentication.
# ---------------------------------------------------------------------------
# Username/password sent by every MQTT client. The secured broker requires them
# (create the password file: MQTT_USERNAME=.. MQTT_PASSWORD=.. ./security/gen-passwd.sh).
# The open dev broker ignores them.
MQTT_USERNAME=bushfire
MQTT_PASSWORD=dev-change-me-mqtt

# ---------------------------------------------------------------------------
# Broker config selection.
# ---------------------------------------------------------------------------
# mosquitto.dev.conf = open (anonymous, 1883)  [default, for scaling tests]
# mosquitto.conf     = secured (auth + TLS 8883)
MOSQUITTO_CONF=mosquitto.dev.conf

# ---------------------------------------------------------------------------
# MQTT client connection (used by the dashboard/node-red containers).
# ---------------------------------------------------------------------------
# Open/auth over 1883:   mqtt://mosquitto:1883
# TLS (MQTTS) over 8883:  mqtts://mosquitto:8883
MQTT_URL=mqtt://mosquitto:1883
# CA cert path INSIDE the containers (mounted from ./security). Host scripts
# (sensors/*) default to ./security/ca.crt instead — override with MQTT_CA_FILE.
MQTT_CA_FILE=/security/ca.crt

# ---------------------------------------------------------------------------
# Optional: IFTTT Maker Webhooks notifications (alert service). Leave blank to
# log only.
# ---------------------------------------------------------------------------
IFTTT_KEY=
IFTTT_EVENT=bushfire_alert
